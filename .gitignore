# macOS / editor noise
.DS_Store
*.swp
*.swo

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/

# Local env / secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.mobileprovision

# Generated packages and experiments
dist/
experiments/

# Node / Remotion runtime caches
node_modules/
.remotion/
.cache/
pnpm-lock.yaml
pnpm-workspace.yaml

# JaguarTV runtime workspace: source videos, rendered videos, DB, login sessions.
# Keep reproducible source code/config in git, not local media or account state.
workspace/*
!workspace/.gitkeep

# Common generated media
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.aiff
*.wav
*.mp3
*.m4a
