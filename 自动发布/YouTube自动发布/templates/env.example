# Copy this file to the server environment manager or local .env.
# Never commit real values.

JAGUARTV_GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
JAGUARTV_GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
JAGUARTV_GOOGLE_REDIRECT_URI=https://factory.jarg.top/oauth/youtube/callback
JAGUARTV_PUBLIC_BASE_URL=https://factory.jarg.top

# Used to encrypt/decrypt YouTube OAuth refresh tokens stored in sqlite.
# Keep stable after authorization; changing it invalidates stored encrypted tokens.
JAGUARTV_OAUTH_TOKEN_KEY=replace-with-long-random-local-encryption-key

# Used to sign OAuth state during the browser authorization flow.
JAGUARTV_OAUTH_STATE_SECRET=replace-with-long-random-state-secret

# Optional: Doubao/OpenAI-compatible chat completions API for automatic pt-BR
# publishing copy. If omitted, the publisher uses a local fallback and still
# queues/publishes the video.
JAGUARTV_DOUBAO_API_KEY=
JAGUARTV_DOUBAO_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/chat/completions
JAGUARTV_DOUBAO_MODEL=
JAGUARTV_DOUBAO_TIMEOUT_SEC=30

# Optional: for one-off emergency upload only. Prefer OAuth refresh flow.
# JAGUARTV_YOUTUBE_JAGUARTV_VIVO_ACCESS_TOKEN=temporary-access-token
