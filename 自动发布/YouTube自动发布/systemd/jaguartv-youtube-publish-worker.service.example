[Unit]
Description=JaguarTV YouTube Publish Worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/jaguartv-content-factory-vnext
EnvironmentFile=/opt/jaguartv-content-factory-vnext/.env
ExecStart=/opt/jaguartv-content-factory-vnext/.venv/bin/jaguartv --config config/pipeline.yaml publish-worker --sleep 60 --limit 3
Restart=always
RestartSec=10

# Keep tokens and media files private to the service user.
UMask=0077

[Install]
WantedBy=multi-user.target
