# Dashboard and worker credentials are generated or supplied only on the server.
JAGUARTV_DASHBOARD_TOKEN=
JAGUARTV_EVENTS_TOKEN=
JAGUARTV_UPLOAD_TOKEN=

# Publishing copy uses OpenAI Responses API. Never commit the real key.
JAGUARTV_PUBLISHING_AI_API_KEY=
JAGUARTV_PUBLISHING_AI_MODEL=gpt-5.6-terra
JAGUARTV_OPENAI_BASE_URL=https://api.openai.com/v1

# KrillinAI localization providers. These names configure the ignored private
# config; each production request may still override the provider-specific voice.
KRILLINAI_API_KEY=
KRILLINAI_BASE_URL=
KRILLINAI_LLM_MODEL=
KRILLINAI_TRANSCRIBE_PROVIDER=openai
KRILLINAI_TRANSCRIBE_MODEL=whisper-1
KRILLINAI_TTS_PROVIDER=edge-tts
KRILLINAI_TTS_MODEL=
KRILLIN_EDGE_TTS_DEFAULT_VOICE=pt-BR-AntonioNeural
